{
  "name": "choropleth-kit",
  "version": "0.1.0",
  "description": "Choropleth (thematic) maps for React: zoom, drill-down, legends, theming. Three API levels, d3-geo under the hood.",
  "author": "Manuel Martín",
  "keywords": [
    "choropleth",
    "map",
    "react",
    "svg",
    "d3",
    "d3-geo",
    "topojson",
    "geojson",
    "thematic-map",
    "drill-down",
    "data-visualization"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manoplo/choropleth-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Manoplo/choropleth-kit/issues"
  },
  "homepage": "https://github.com/Manoplo/choropleth-kit#readme",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "import": "./dist/geo.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "geo": [
        "./dist/geo.d.ts"
      ]
    }
  },
  "scripts": {
    "prepare": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.includes('pnpm')){console.error('Use pnpm. This project does not support npm or yarn.');process.exit(1)}\"",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "size": "pnpm build && size-limit",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check:package": "publint && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution --profile esm-only",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && size-limit && pnpm check:package",
    "prepublishOnly": "pnpm verify"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.6",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "i18n-iso-countries": "^7.14.0",
    "jsdom": "^27.0.1",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "storybook": "^10.6.5",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-specification": "^1.0.5",
    "d3-ease": "^3.0.2",
    "d3-geo": "^3.1.2",
    "d3-interpolate": "^3.0.2",
    "d3-scale": "^4.0.3",
    "d3-scale-chromatic": "^3.1.1",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "polylabel": "^2.1.0",
    "topojson-client": "^3.1.0"
  }
}
