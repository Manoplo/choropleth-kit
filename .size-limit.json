[
  {
    "name": "Own code: core + react (external dependencies)",
    "path": "dist/index.js",
    "import": "*",
    "gzip": true,
    "ignore": [
      "react",
      "react-dom",
      "d3-ease",
      "d3-geo",
      "d3-interpolate",
      "d3-scale",
      "d3-scale-chromatic",
      "d3-selection",
      "d3-transition",
      "d3-zoom",
      "polylabel",
      "topojson-client"
    ],
    "limit": "50 KB"
  },
  {
    "name": "Real cost for consumers: ChoroplethMap with all of d3 (without React)",
    "path": "dist/index.js",
    "import": "{ ChoroplethMap }",
    "gzip": true,
    "ignore": ["react", "react-dom"],
    "limit": "75 KB"
  },
  {
    "name": "core alone with its dependencies (without React)",
    "path": "dist/core.js",
    "import": "*",
    "gzip": true,
    "limit": "50 KB"
  },
  {
    "name": "styles.css",
    "path": "dist/styles.css",
    "gzip": true,
    "limit": "5 KB"
  },
  {
    "name": "geo: world-110m (data, outside the JS budget)",
    "path": "dist/geo.js",
    "import": "*",
    "gzip": true,
    "limit": "60 KB"
  }
]
