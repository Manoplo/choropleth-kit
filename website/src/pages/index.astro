---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/landing.css";
import HeroDemo from "../components/HeroDemo";
import ApiLevels from "../components/ApiLevels";
import InstallChip from "../components/InstallChip";
import ThemeSelect from "../components/ThemeSelect.astro";

const repo = "https://github.com/Manoplo/choropleth-kit";

const features = [
  {
    title: "Four variants, one prop",
    text: "Sequential, diverging, categorical and bubble (size plus color). Switch the variant and the legend, scale and tooltip follow.",
    proof: 'variant="diverging"',
  },
  {
    title: "A camera you can await",
    text: "Wheel, pinch, inertia and controls built in. Fly to a country from code and chain flights without timers.",
    proof: 'await map.zoomTo("ES");',
  },
  {
    title: "Drill-down without extra plumbing",
    text: "Declare the levels once: world, country, region. The first level below 238 countries ships in the package and loads only when needed.",
    proof: "defineDrillLevels([…])",
  },
  {
    title: "Joins that tell you what is wrong",
    text: "A country id that matches nothing, or regions without data, shows up in the dev console with the cause, not as a silently blank map.",
    proof: "172 region(s) have no data",
  },
  {
    title: "Theming with plain CSS",
    text: "Four themes, every detail exposed as a --cm-* variable, Tailwind-friendly classNames and data-* attributes on each region.",
    proof: "--cm-border-color: #fff;",
  },
  {
    title: "Hover and pan never re-render React",
    text: "Interaction state lives outside React, so a map with hundreds of regions stays responsive while you move over it.",
    proof: "useMapStore(store, selector)",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>choropleth-kit: choropleth maps for React</title>
    <meta
      name="description"
      content="Choropleth (thematic) maps for React in ten lines. SVG on d3-geo with zoom, drill-down, legends and theming included."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Runs before first paint so there is no flash of the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem("starlight-theme");
          var dark =
            stored === "dark" ||
            (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.dataset.theme = dark ? "dark" : "light";
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap top-in">
        <a class="brand" href="/" aria-label="choropleth-kit home">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <rect x="1" y="1" width="8" height="8" rx="1.5" class="m1"></rect>
            <rect x="11" y="1" width="8" height="8" rx="1.5" class="m3"></rect>
            <rect x="1" y="11" width="8" height="8" rx="1.5" class="m2"></rect>
            <rect x="11" y="11" width="8" height="8" rx="1.5" class="m4"></rect>
          </svg>
          choropleth-kit
        </a>
        <div class="top-right">
        <nav aria-label="Main">
          <a href="/getting-started/">Docs</a>
          <a class="gh" href={repo}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            GitHub
          </a>
        </nav>
        <ThemeSelect />
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero wrap">
        <h1>Choropleth maps for React, in ten lines.</h1>
        <p class="lede">
          SVG on d3-geo, with zoom, drill-down, legends and theming included. Start with one component,
          drop a level when you need more.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/getting-started/">Get started</a>
          <InstallChip client:load />
        </div>
        <p class="status">Version 0.3, pre-1.0 (the API may change). MIT licensed.</p>
        <HeroDemo client:load />
      </section>

      <section class="section wrap" aria-labelledby="levels-h">
        <div class="section-head">
          <h2 id="levels-h">One implementation, three levels</h2>
          <p>
            Begin with the preset. When you need a different layout, take the pieces. When you need your
            own rendering, take the data. Nothing is rewritten between levels.
          </p>
        </div>
        <ApiLevels client:visible />
      </section>

      <section class="section wrap" aria-labelledby="feat-h">
        <div class="section-head">
          <h2 id="feat-h">What a map usually costs you, already done</h2>
        </div>
        <ul class="features">
          {
            features.map((f) => (
              <li>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
                <code>{f.proof}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section wrap close" aria-labelledby="close-h">
        <h2 id="close-h">Install it. Render a map.</h2>
        <p>The package is ESM only, ships its own types and needs React 18 or newer.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/getting-started/">Read the guide</a>
          <InstallChip client:visible />
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot-in">
        <p>MIT © Manuel Martín. Geodata from Natural Earth (public domain).</p>
        <nav aria-label="Footer">
          <a href="/getting-started/">Docs</a>
          <a class="gh" href={repo}>
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            GitHub
          </a>
        </nav>
      </div>
    </footer>
  </body>
</html>
